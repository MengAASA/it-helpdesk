{
  "subject": "[{{ticketNumber}}] Status updated: {{status}}",
  "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"x-apple-disable-message-reformatting\">\n\n    <title>Ticket Status Updated</title>\n\n    <style>\n        body {\n            margin: 0;\n            padding: 0;\n            background-color: #f3f1f8;\n            font-family: Arial, Helvetica, sans-serif;\n            color: #25212f;\n        }\n\n        table {\n            border-spacing: 0;\n            border-collapse: collapse;\n        }\n\n        td {\n            padding: 0;\n        }\n\n        .email-wrapper {\n            width: 100%;\n            background-color: #f3f1f8;\n            padding: 40px 15px;\n        }\n\n        .email-card {\n            width: 100%;\n            max-width: 600px;\n            background-color: #ffffff;\n            border-radius: 16px;\n            overflow: hidden;\n        }\n\n        /* HEADER */\n\n        .header {\n            background-color: #231753;\n            background: linear-gradient(\n                135deg,\n                #231753 0%,\n                #480550 100%\n            );\n            padding: 30px 36px 34px;\n        }\n\n        .brand {\n            color: #ffffff;\n            font-size: 15px;\n            font-weight: bold;\n            letter-spacing: 0.3px;\n            white-space: nowrap;\n        }\n\n        .notification-badge {\n            display: inline-block;\n            padding: 6px 10px;\n            border: 1px solid rgba(255,255,255,0.3);\n            border-radius: 20px;\n            color: #ffffff;\n            font-size: 9px;\n            font-weight: bold;\n            letter-spacing: 0.8px;\n            line-height: 12px;\n            white-space: nowrap;\n        }\n\n        .header-title {\n            margin: 24px 0 6px;\n            color: #ffffff;\n            font-size: 27px;\n            line-height: 34px;\n            font-weight: bold;\n        }\n\n        .header-subtitle {\n            margin: 0;\n            color: rgba(255,255,255,0.75);\n            font-size: 14px;\n            line-height: 21px;\n        }\n\n        /* CONTENT */\n\n        .content {\n            padding: 34px 36px;\n        }\n\n        .greeting {\n            margin: 0 0 14px;\n            color: #25212f;\n            font-size: 15px;\n            line-height: 24px;\n        }\n\n        .description {\n            margin: 0 0 25px;\n            color: #686271;\n            font-size: 14px;\n            line-height: 22px;\n        }\n\n        /* TICKET CARD */\n\n        .ticket-card {\n            width: 100%;\n            background-color: #f8f7fb;\n            border: 1px solid #ebe8f1;\n            border-radius: 12px;\n        }\n\n        .ticket-card-inner {\n            padding: 20px;\n        }\n\n        .ticket-label {\n            margin: 0 0 7px;\n            color: #817b8d;\n            font-size: 10px;\n            font-weight: bold;\n            letter-spacing: 1px;\n            text-transform: uppercase;\n        }\n\n        .ticket-number {\n            margin: 0;\n            color: #231753;\n            font-size: 15px;\n            font-weight: bold;\n        }\n\n        .divider {\n            height: 1px;\n            background-color: #e8e5ee;\n            margin: 18px 0;\n            line-height: 1px;\n            font-size: 1px;\n        }\n\n        .subject {\n            margin: 0;\n            color: #25212f;\n            font-size: 15px;\n            line-height: 22px;\n            font-weight: bold;\n        }\n\n        /* STATUS */\n\n        .status-section {\n            margin-top: 18px;\n        }\n\n        .status-label {\n            margin: 0 0 8px;\n            color: #817b8d;\n            font-size: 10px;\n            font-weight: bold;\n            letter-spacing: 1px;\n            text-transform: uppercase;\n        }\n\n        .status-badge {\n            display: inline-block;\n            padding: 7px 12px;\n            border-radius: 20px;\n            background-color: #eeeaf7;\n            color: #480550;\n            font-size: 11px;\n            font-weight: bold;\n            letter-spacing: 0.3px;\n            text-transform: uppercase;\n        }\n\n        /* CTA */\n\n        .cta {\n            padding: 30px 0 10px;\n            text-align: center;\n        }\n\n        /* INFORMATION BOX */\n\n        .info-box {\n            margin-top: 25px;\n            padding: 15px 16px;\n            background-color: #f8f6fb;\n            border-left: 3px solid #480550;\n            border-radius: 6px;\n        }\n\n        .info-box p {\n            margin: 0;\n            color: #686271;\n            font-size: 12px;\n            line-height: 19px;\n        }\n\n        /* FOOTER */\n\n        .footer {\n            padding: 24px 36px 30px;\n            border-top: 1px solid #eeeaf2;\n            text-align: center;\n        }\n\n        .footer p {\n            margin: 0;\n            color: #9993a2;\n            font-size: 11px;\n            line-height: 18px;\n        }\n\n        /* DARK MODE */\n\n        [data-ogsc] .status-badge {\n            color: #ffffff !important;\n            background-color: #480550 !important;\n        }\n\n        @media (prefers-color-scheme: dark) {\n            .status-badge {\n                color: #ffffff !important;\n                background-color: #480550 !important;\n            }\n        }\n\n        /* MOBILE */\n\n        @media only screen and (max-width: 620px) {\n\n            .email-wrapper {\n                padding: 20px 10px;\n            }\n\n            .header {\n                padding: 26px 24px 30px;\n            }\n\n            .content {\n                padding: 28px 24px;\n            }\n\n            .footer {\n                padding: 22px 24px 28px;\n            }\n\n            .header-title {\n                font-size: 24px;\n                line-height: 31px;\n            }\n\n            .brand {\n                font-size: 14px;\n            }\n\n            .notification-badge {\n                font-size: 8px;\n                padding: 5px 8px;\n            }\n        }\n\n        /* OUTLOOK */\n\n        @media screen and (-ms-high-contrast: active),\n               screen and (-ms-high-contrast: none) {\n            .header-title,\n            .brand,\n            .notification-badge,\n            .ticket-number,\n            .subject,\n            .status-badge {\n                font-family: Arial, Helvetica, sans-serif !important;\n            }\n        }\n    </style>\n\n    <!--[if mso]>\n    <style>\n        body,\n        table,\n        td,\n        p,\n        a,\n        div,\n        span {\n            font-family: Arial, Helvetica, sans-serif !important;\n        }\n    </style>\n    <![endif]-->\n\n</head>\n\n<body>\n\n<table\n    role=\"presentation\"\n    width=\"100%\"\n    cellpadding=\"0\"\n    cellspacing=\"0\"\n    border=\"0\"\n    class=\"email-wrapper\"\n>\n    <tr>\n        <td align=\"center\">\n\n            <table\n                role=\"presentation\"\n                width=\"100%\"\n                cellpadding=\"0\"\n                cellspacing=\"0\"\n                border=\"0\"\n                class=\"email-card\"\n                style=\"max-width:600px;\"\n            >\n\n                <!-- ========================= -->\n                <!-- HEADER -->\n                <!-- ========================= -->\n\n                <tr>\n                    <td class=\"header\">\n\n                        <table\n                            role=\"presentation\"\n                            width=\"100%\"\n                            cellpadding=\"0\"\n                            cellspacing=\"0\"\n                            border=\"0\"\n                        >\n                            <tr>\n\n                                <!-- IT HELPDESK -->\n                                <td\n                                    align=\"left\"\n                                    valign=\"middle\"\n                                    style=\"padding-right:10px;\"\n                                >\n                                    <div class=\"brand\">\n                                        IT Helpdesk\n                                    </div>\n                                </td>\n\n                                <!-- TICKET UPDATED -->\n                                <td\n                                    align=\"right\"\n                                    valign=\"middle\"\n                                >\n                                    <span class=\"notification-badge\">\n                                        TICKET UPDATED\n                                    </span>\n                                </td>\n\n                            </tr>\n                        </table>\n\n                        <div class=\"header-title\">\n                            Ticket status updated\n                        </div>\n\n                        <p class=\"header-subtitle\">\n                            Your support ticket has received a status update.\n                        </p>\n\n                    </td>\n                </tr>\n\n\n                <!-- ========================= -->\n                <!-- CONTENT -->\n                <!-- ========================= -->\n\n                <tr>\n                    <td class=\"content\">\n\n                        <p class=\"greeting\">\n                            Hi {{requesterName}},\n                        </p>\n\n                        <p class=\"description\">\n                            There has been an update to your support ticket.\n                            Please review the latest status and ticket details below.\n                        </p>\n\n\n                        <!-- ========================= -->\n                        <!-- TICKET DETAILS -->\n                        <!-- ========================= -->\n\n                        <table\n                            role=\"presentation\"\n                            width=\"100%\"\n                            cellpadding=\"0\"\n                            cellspacing=\"0\"\n                            border=\"0\"\n                            class=\"ticket-card\"\n                        >\n                            <tr>\n                                <td class=\"ticket-card-inner\">\n\n                                    <p class=\"ticket-label\">\n                                        Ticket\n                                    </p>\n\n                                    <p class=\"ticket-number\">\n                                        {{ticketNumber}}\n                                    </p>\n\n\n                                    <div class=\"divider\">\n                                        &nbsp;\n                                    </div>\n\n\n                                    <p class=\"ticket-label\">\n                                        Subject\n                                    </p>\n\n                                    <p class=\"subject\">\n                                        {{subject}}\n                                    </p>\n\n\n                                    <div class=\"status-section\">\n\n                                        <p class=\"status-label\">\n                                            Current Status\n                                        </p>\n\n                                        <span class=\"status-badge\">\n                                            {{status}}\n                                        </span>\n\n                                    </div>\n\n                                </td>\n                            </tr>\n                        </table>\n\n\n                           <!-- =================================================\n                             BUTTON SPACING\n                             ================================================= -->\n\n                        <div style=\"\n                            height:28px;\n                            line-height:28px;\n                            font-size:1px;\n                        \">\n                            &nbsp;\n                        </div>\n\n\n                        <!-- =================================================\n                             OUTLOOK BUTTON\n                             ================================================= -->\n\n                        <!--[if mso]>\n\n                        <table\n                            role=\"presentation\"\n                            cellpadding=\"0\"\n                            cellspacing=\"0\"\n                            border=\"0\"\n                        >\n                            <tr>\n                                <td align=\"left\">\n\n                                    <v:roundrect\n                                        xmlns:v=\"urn:schemas-microsoft-com:vml\"\n                                        xmlns:w=\"urn:schemas-microsoft-com:office:word\"\n                                        href=\"{{ticketUrl}}\"\n                                        style=\"\n                                            height:46px;\n                                            v-text-anchor:middle;\n                                            width:160px;\n                                        \"\n                                        arcsize=\"17%\"\n                                        strokecolor=\"#480550\"\n                                        fillcolor=\"#480550\"\n                                    >\n\n                                        <w:anchorlock/>\n\n                                        <center\n                                            style=\"\n                                                color:#ffffff;\n                                                font-family:Arial, Helvetica, sans-serif;\n                                                font-size:14px;\n                                                font-weight:bold;\n                                            \"\n                                        >\n                                            <font\n                                                color=\"#ffffff\"\n                                                style=\"\n                                                    color:#ffffff;\n                                                    font-family:Arial, Helvetica, sans-serif;\n                                                    font-size:14px;\n                                                    font-weight:bold;\n                                                \"\n                                            >\n                                                View Ticket\n                                            </font>\n                                        </center>\n\n                                    </v:roundrect>\n\n                                </td>\n                            </tr>\n                        </table>\n\n                        <![endif]-->\n\n\n                        <!-- =================================================\n                             NORMAL HTML BUTTON\n                             ================================================= -->\n\n                        <!--[if !mso]><!-->\n\n                        <table\n                            role=\"presentation\"\n                            cellpadding=\"0\"\n                            cellspacing=\"0\"\n                            border=\"0\"\n                        >\n                            <tr>\n                                <td\n                                    align=\"center\"\n                                    bgcolor=\"#480550\"\n                                    class=\"ticket-button\"\n                                    style=\"\n                                        background-color:#480550;\n                                        border:1px solid #480550;\n                                        border-radius:8px;\n                                    \"\n                                >\n\n                                    <a\n                                        href=\"{{ticketUrl}}\"\n                                        target=\"_blank\"\n                                        class=\"btn-text\"\n                                        style=\"\n                                            display:inline-block;\n                                            padding:13px 26px;\n                                            background-color:#480550;\n                                            border-radius:8px;\n                                            color:#ffffff !important;\n                                            font-family:Arial, Helvetica, sans-serif;\n                                            font-size:14px;\n                                            line-height:20px;\n                                            font-weight:700;\n                                            text-decoration:none;\n                                        \"\n                                    >\n\n                                        <span\n                                            class=\"ticket-button-text\"\n                                            style=\"\n                                                color:#ffffff !important;\n                                                font-family:Arial, Helvetica, sans-serif;\n                                                font-size:14px;\n                                                line-height:20px;\n                                                font-weight:700;\n                                            \"\n                                        >\n                                            View Ticket\n                                        </span>\n\n                                    </a>\n\n                                </td>\n                            </tr>\n                        </table>\n\n                        <!--<![endif]-->\n\n\n                        <!-- =================================================\n                             INFO SPACING\n                             ================================================= -->\n\n                        <div style=\"\n                            height:28px;\n                            line-height:28px;\n                            font-size:1px;\n                        \">\n                            &nbsp;\n                        </div>\n\n\n\n                        <!-- ========================= -->\n                        <!-- INFORMATION -->\n                        <!-- ========================= -->\n\n                        <div class=\"info-box\">\n\n                            <p>\n                                Please review the ticket for the latest\n                                information and any updates from the\n                                IT Helpdesk team.\n                            </p>\n\n                        </div>\n\n                    </td>\n                </tr>\n\n\n                <!-- ========================= -->\n                <!-- FOOTER -->\n                <!-- ========================= -->\n\n                <tr>\n                    <td class=\"footer\">\n\n                        <p>\n                            This is an automated notification from IT Helpdesk.\n                        </p>\n\n                        <p style=\"margin-top:5px;\">\n                            Please do not reply directly to this email.\n                        </p>\n\n                        <p style=\"margin-top:12px;\">\n                            © IT Helpdesk\n                        </p>\n\n                    </td>\n                </tr>\n\n            </table>\n\n        </td>\n    </tr>\n</table>\n\n</body>\n</html>"
}