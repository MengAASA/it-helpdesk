{
  "subject": "[{{ticketNumber}}] Assigned to you: {{subject}}",
  "body": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n\n    <title>Ticket Assigned</title>\n\n    <style>\n        /* =========================================================\n           DARK MODE PROTECTION\n           ========================================================= */\n\n        /* Outlook.com / New Outlook */\n        [data-ogsc] .btn-text,\n        [data-ogsc] .btn-text a,\n        [data-ogsc] .btn-text span {\n            color: #ffffff !important;\n        }\n\n        /* Other dark mode email clients */\n        @media (prefers-color-scheme: dark) {\n\n            .btn-text,\n            .btn-text a,\n            .btn-text span {\n                color: #ffffff !important;\n            }\n\n            .ticket-button {\n                background-color: #480550 !important;\n                border-color: #480550 !important;\n            }\n\n            .ticket-button-text {\n                color: #ffffff !important;\n            }\n        }\n\n        /* Mobile */\n        @media only screen and (max-width: 620px) {\n\n            .email-wrapper {\n                padding: 20px 10px !important;\n            }\n\n            .email-card {\n                width: 100% !important;\n            }\n\n            .content-padding {\n                padding: 28px 22px 32px 22px !important;\n            }\n\n            .header-padding {\n                padding: 24px 22px !important;\n            }\n\n            .header-title {\n                font-size: 24px !important;\n                line-height: 32px !important;\n            }\n\n            .ticket-subject {\n                font-size: 16px !important;\n                line-height: 24px !important;\n            }\n        }\n    </style>\n\n    <!--[if mso]>\n    <style>\n        body,\n        table,\n        td,\n        p,\n        a,\n        span {\n            font-family: Arial, Helvetica, sans-serif !important;\n        }\n    </style>\n    <![endif]-->\n\n</head>\n\n\n<body style=\"\n    margin:0;\n    padding:0;\n    width:100%;\n    background-color:#f3f1f8;\n    font-family:Arial, Helvetica, sans-serif;\n\">\n\n\n<!-- =============================================================\n     OUTER WRAPPER\n     ============================================================= -->\n\n<table\n    role=\"presentation\"\n    width=\"100%\"\n    cellpadding=\"0\"\n    cellspacing=\"0\"\n    border=\"0\"\n    style=\"\n        width:100%;\n        margin:0;\n        padding:0;\n        background-color:#f3f1f8;\n    \"\n>\n    <tr>\n        <td\n            align=\"center\"\n            class=\"email-wrapper\"\n            style=\"padding:45px 15px;\"\n        >\n\n\n            <!-- =================================================\n                 EMAIL CARD\n                 ================================================= -->\n\n            <table\n                role=\"presentation\"\n                width=\"600\"\n                cellpadding=\"0\"\n                cellspacing=\"0\"\n                border=\"0\"\n                class=\"email-card\"\n                style=\"\n                    width:100%;\n                    max-width:600px;\n                    background-color:#ffffff;\n                    border-radius:16px;\n                    overflow:hidden;\n                \"\n            >\n\n\n                <!-- =================================================\n                     HEADER\n                     ================================================= -->\n\n                <tr>\n                    <td\n                        class=\"header-padding\"\n                        style=\"\n                            padding:28px 32px;\n                            background-color:#231753;\n                            background:linear-gradient(\n                                135deg,\n                                #231753 0%,\n                                #480550 100%\n                            );\n                        \"\n                    >\n\n                        <!-- Brand Row -->\n\n                        <table\n                            role=\"presentation\"\n                            width=\"100%\"\n                            cellpadding=\"0\"\n                            cellspacing=\"0\"\n                            border=\"0\"\n                        >\n                            <tr>\n\n                                <!-- Brand -->\n\n                                <td align=\"left\">\n\n                                    <div style=\"\n                                        color:#ffffff;\n                                        font-family:Arial, Helvetica, sans-serif;\n                                        font-size:20px;\n                                        line-height:28px;\n                                        font-weight:700;\n                                    \">\n                                        IT Helpdesk\n                                    </div>\n\n                                </td>\n\n\n                                <!-- Notification Badge -->\n\n                                <td align=\"right\">\n\n                                    <table\n                                        role=\"presentation\"\n                                        cellpadding=\"0\"\n                                        cellspacing=\"0\"\n                                        border=\"0\"\n                                    >\n                                        <tr>\n                                            <td\n                                                style=\"\n                                                    padding:6px 11px;\n                                                    border:1px solid rgba(255,255,255,0.30);\n                                                    border-radius:20px;\n                                                \"\n                                            >\n\n                                                <span style=\"\n                                                    color:#ffffff;\n                                                    font-family:Arial, Helvetica, sans-serif;\n                                                    font-size:10px;\n                                                    line-height:16px;\n                                                    font-weight:700;\n                                                    letter-spacing:0.7px;\n                                                \">\n                                                    NOTIFICATION\n                                                </span>\n\n                                            </td>\n                                        </tr>\n                                    </table>\n\n                                </td>\n\n                            </tr>\n                        </table>\n\n\n                        <!-- Header Spacing -->\n\n                        <div style=\"\n                            height:38px;\n                            line-height:38px;\n                            font-size:1px;\n                        \">\n                            &nbsp;\n                        </div>\n\n\n                        <!-- Header Title -->\n\n                        <div\n                            class=\"header-title\"\n                            style=\"\n                                color:#ffffff;\n                                font-family:Arial, Helvetica, sans-serif;\n                                font-size:28px;\n                                line-height:36px;\n                                font-weight:700;\n                                letter-spacing:-0.5px;\n                            \"\n                        >\n                            New ticket assigned\n                        </div>\n\n\n                        <!-- Header Subtitle -->\n\n                        <div style=\"\n                            margin-top:8px;\n                            color:#d9d4e7;\n                            font-family:Arial, Helvetica, sans-serif;\n                            font-size:14px;\n                            line-height:22px;\n                        \">\n                            A support ticket requires your attention.\n                        </div>\n\n                    </td>\n                </tr>\n\n\n                <!-- =================================================\n                     CONTENT\n                     ================================================= -->\n\n                <tr>\n                    <td\n                        class=\"content-padding\"\n                        style=\"\n                            padding:35px 35px 40px 35px;\n                            background-color:#ffffff;\n                        \"\n                    >\n\n\n                        <!-- Greeting -->\n\n                        <p style=\"\n                            margin:0 0 8px 0;\n                            padding:0;\n                            color:#231753;\n                            font-family:Arial, Helvetica, sans-serif;\n                            font-size:16px;\n                            line-height:25px;\n                            font-weight:700;\n                        \">\n                            Hi {{assigneeName}},\n                        </p>\n\n\n                        <!-- Introduction -->\n\n                        <p style=\"\n                            margin:0 0 28px 0;\n                            padding:0;\n                            color:#666666;\n                            font-family:Arial, Helvetica, sans-serif;\n                            font-size:14px;\n                            line-height:23px;\n                        \">\n                            A new support ticket has been assigned to you.\n                            Please review the details below and take the necessary action.\n                        </p>\n\n\n                        <!-- =================================================\n                             TICKET CARD\n                             ================================================= -->\n\n                        <table\n                            role=\"presentation\"\n                            width=\"100%\"\n                            cellpadding=\"0\"\n                            cellspacing=\"0\"\n                            border=\"0\"\n                            style=\"\n                                width:100%;\n                                border:1px solid #e9e6ef;\n                                border-radius:12px;\n                                overflow:hidden;\n                                background-color:#ffffff;\n                            \"\n                        >\n\n\n                            <!-- Ticket Top -->\n\n                            <tr>\n                                <td style=\"\n                                    padding:18px 20px;\n                                    background-color:#faf9fc;\n                                    border-bottom:1px solid #e9e6ef;\n                                \">\n\n                                    <table\n                                        role=\"presentation\"\n                                        width=\"100%\"\n                                        cellpadding=\"0\"\n                                        cellspacing=\"0\"\n                                        border=\"0\"\n                                    >\n                                        <tr>\n\n                                            <!-- Ticket Number -->\n\n                                            <td align=\"left\" valign=\"middle\">\n\n                                                <div style=\"\n                                                    color:#77717f;\n                                                    font-family:Arial, Helvetica, sans-serif;\n                                                    font-size:10px;\n                                                    line-height:16px;\n                                                    font-weight:700;\n                                                    text-transform:uppercase;\n                                                    letter-spacing:0.9px;\n                                                \">\n                                                    Ticket\n                                                </div>\n\n                                                <div style=\"\n                                                    margin-top:4px;\n                                                    color:#231753;\n                                                    font-family:Arial, Helvetica, sans-serif;\n                                                    font-size:16px;\n                                                    line-height:23px;\n                                                    font-weight:700;\n                                                \">\n                                                    {{ticketNumber}}\n                                                </div>\n\n                                            </td>\n\n\n                                            <!-- Status -->\n\n                                            <td align=\"right\" valign=\"middle\">\n\n                                                <table\n                                                    role=\"presentation\"\n                                                    cellpadding=\"0\"\n                                                    cellspacing=\"0\"\n                                                    border=\"0\"\n                                                >\n                                                    <tr>\n                                                        <td\n                                                            style=\"\n                                                                padding:6px 12px;\n                                                                background-color:#f0eafa;\n                                                                border-radius:20px;\n                                                            \"\n                                                        >\n\n                                                            <span style=\"\n                                                                color:#480550;\n                                                                font-family:Arial, Helvetica, sans-serif;\n                                                                font-size:10px;\n                                                                line-height:16px;\n                                                                font-weight:700;\n                                                                letter-spacing:0.5px;\n                                                            \">\n                                                                ASSIGNED\n                                                            </span>\n\n                                                        </td>\n                                                    </tr>\n                                                </table>\n\n                                            </td>\n\n                                        </tr>\n                                    </table>\n\n                                </td>\n                            </tr>\n\n\n                            <!-- Subject -->\n\n                            <tr>\n                                <td style=\"padding:22px 20px 24px 20px;\">\n\n                                    <div style=\"\n                                        margin-bottom:8px;\n                                        color:#99939f;\n                                        font-family:Arial, Helvetica, sans-serif;\n                                        font-size:10px;\n                                        line-height:16px;\n                                        font-weight:700;\n                                        text-transform:uppercase;\n                                        letter-spacing:0.8px;\n                                    \">\n                                        Subject\n                                    </div>\n\n                                    <div\n                                        class=\"ticket-subject\"\n                                        style=\"\n                                            color:#29242f;\n                                            font-family:Arial, Helvetica, sans-serif;\n                                            font-size:17px;\n                                            line-height:26px;\n                                            font-weight:700;\n                                        \"\n                                    >\n                                        {{subject}}\n                                    </div>\n\n                                </td>\n                            </tr>\n\n                        </table>\n\n\n                        <!-- =================================================\n                             BUTTON SPACING\n                             ================================================= -->\n\n                        <div style=\"\n                            height:28px;\n                            line-height:28px;\n                            font-size:1px;\n                        \">\n                            &nbsp;\n                        </div>\n\n\n                        <!-- =================================================\n                             OUTLOOK BUTTON\n                             ================================================= -->\n\n                        <!--[if mso]>\n\n                        <table\n                            role=\"presentation\"\n                            cellpadding=\"0\"\n                            cellspacing=\"0\"\n                            border=\"0\"\n                        >\n                            <tr>\n                                <td align=\"left\">\n\n                                    <v:roundrect\n                                        xmlns:v=\"urn:schemas-microsoft-com:vml\"\n                                        xmlns:w=\"urn:schemas-microsoft-com:office:word\"\n                                        href=\"{{ticketUrl}}\"\n                                        style=\"\n                                            height:46px;\n                                            v-text-anchor:middle;\n                                            width:160px;\n                                        \"\n                                        arcsize=\"17%\"\n                                        strokecolor=\"#480550\"\n                                        fillcolor=\"#480550\"\n                                    >\n\n                                        <w:anchorlock/>\n\n                                        <center\n                                            style=\"\n                                                color:#ffffff;\n                                                font-family:Arial, Helvetica, sans-serif;\n                                                font-size:14px;\n                                                font-weight:bold;\n                                            \"\n                                        >\n                                            <font\n                                                color=\"#ffffff\"\n                                                style=\"\n                                                    color:#ffffff;\n                                                    font-family:Arial, Helvetica, sans-serif;\n                                                    font-size:14px;\n                                                    font-weight:bold;\n                                                \"\n                                            >\n                                                View Ticket\n                                            </font>\n                                        </center>\n\n                                    </v:roundrect>\n\n                                </td>\n                            </tr>\n                        </table>\n\n                        <![endif]-->\n\n\n                        <!-- =================================================\n                             NORMAL HTML BUTTON\n                             ================================================= -->\n\n                        <!--[if !mso]><!-->\n\n                        <table\n                            role=\"presentation\"\n                            cellpadding=\"0\"\n                            cellspacing=\"0\"\n                            border=\"0\"\n                        >\n                            <tr>\n                                <td\n                                    align=\"center\"\n                                    bgcolor=\"#480550\"\n                                    class=\"ticket-button\"\n                                    style=\"\n                                        background-color:#480550;\n                                        border:1px solid #480550;\n                                        border-radius:8px;\n                                    \"\n                                >\n\n                                    <a\n                                        href=\"{{ticketUrl}}\"\n                                        target=\"_blank\"\n                                        class=\"btn-text\"\n                                        style=\"\n                                            display:inline-block;\n                                            padding:13px 26px;\n                                            background-color:#480550;\n                                            border-radius:8px;\n                                            color:#ffffff !important;\n                                            font-family:Arial, Helvetica, sans-serif;\n                                            font-size:14px;\n                                            line-height:20px;\n                                            font-weight:700;\n                                            text-decoration:none;\n                                        \"\n                                    >\n\n                                        <span\n                                            class=\"ticket-button-text\"\n                                            style=\"\n                                                color:#ffffff !important;\n                                                font-family:Arial, Helvetica, sans-serif;\n                                                font-size:14px;\n                                                line-height:20px;\n                                                font-weight:700;\n                                            \"\n                                        >\n                                            View Ticket\n                                        </span>\n\n                                    </a>\n\n                                </td>\n                            </tr>\n                        </table>\n\n                        <!--<![endif]-->\n\n\n                        <!-- =================================================\n                             INFO SPACING\n                             ================================================= -->\n\n                        <div style=\"\n                            height:28px;\n                            line-height:28px;\n                            font-size:1px;\n                        \">\n                            &nbsp;\n                        </div>\n\n\n                        <!-- =================================================\n                             INFORMATION BOX\n                             ================================================= -->\n\n                        <table\n                            role=\"presentation\"\n                            width=\"100%\"\n                            cellpadding=\"0\"\n                            cellspacing=\"0\"\n                            border=\"0\"\n                        >\n                            <tr>\n                                <td style=\"\n                                    padding:15px 17px;\n                                    background-color:#f8f7fa;\n                                    border-radius:8px;\n                                \">\n\n                                    <table\n                                        role=\"presentation\"\n                                        cellpadding=\"0\"\n                                        cellspacing=\"0\"\n                                        border=\"0\"\n                                    >\n                                        <tr>\n\n                                            <!-- Indicator -->\n\n                                            <td\n                                                valign=\"top\"\n                                                style=\"padding-right:10px;\"\n                                            >\n\n                                                <div style=\"\n                                                    width:8px;\n                                                    height:8px;\n                                                    margin-top:5px;\n                                                    background-color:#480550;\n                                                    border-radius:50%;\n                                                    font-size:8px;\n                                                    line-height:8px;\n                                                \">\n                                                    &nbsp;\n                                                </div>\n\n                                            </td>\n\n\n                                            <!-- Message -->\n\n                                            <td valign=\"top\">\n\n                                                <span style=\"\n                                                    color:#77717f;\n                                                    font-family:Arial, Helvetica, sans-serif;\n                                                    font-size:12px;\n                                                    line-height:19px;\n                                                \">\n                                                    Please review the ticket and update its status\n                                                    after taking action.\n                                                </span>\n\n                                            </td>\n\n                                        </tr>\n                                    </table>\n\n                                </td>\n                            </tr>\n                        </table>\n\n                    </td>\n                </tr>\n\n\n                <!-- =================================================\n                     FOOTER\n                     ================================================= -->\n\n                <tr>\n                    <td style=\"\n                        padding:22px 30px;\n                        background-color:#faf9fc;\n                        border-top:1px solid #eeeaf2;\n                    \">\n\n                        <p style=\"\n                            margin:0;\n                            padding:0;\n                            color:#9a96a1;\n                            font-family:Arial, Helvetica, sans-serif;\n                            font-size:11px;\n                            line-height:18px;\n                            text-align:center;\n                        \">\n                            This is an automated notification from IT Helpdesk.\n                        </p>\n\n                        <p style=\"\n                            margin:5px 0 0 0;\n                            padding:0;\n                            color:#b0acb5;\n                            font-family:Arial, Helvetica, sans-serif;\n                            font-size:11px;\n                            line-height:18px;\n                            text-align:center;\n                        \">\n                            Please do not reply directly to this email.\n                        </p>\n\n                    </td>\n                </tr>\n\n            </table>\n\n\n            <!-- =================================================\n                 COPYRIGHT\n                 ================================================= -->\n\n            <table\n                role=\"presentation\"\n                width=\"600\"\n                cellpadding=\"0\"\n                cellspacing=\"0\"\n                border=\"0\"\n                style=\"\n                    width:100%;\n                    max-width:600px;\n                \"\n            >\n                <tr>\n                    <td\n                        align=\"center\"\n                        style=\"padding:18px 20px 0 20px;\"\n                    >\n\n                        <span style=\"\n                            color:#aaa6b0;\n                            font-family:Arial, Helvetica, sans-serif;\n                            font-size:10px;\n                            line-height:16px;\n                        \">\n                            © IT Helpdesk\n                        </span>\n\n                    </td>\n                </tr>\n            </table>\n\n        </td>\n    </tr>\n</table>\n\n</body>\n</html>"
}