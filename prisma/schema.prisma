generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model active_sessions {
  staff_no  String   @id @db.VarChar(64)
  name      String   @db.VarChar(255)
  last_seen DateTime @default(now()) @db.DateTime(0)
}

model attachments {
  id          Int     @id @default(autoincrement())
  ticket_id   Int
  filename    String  @db.VarChar(255)
  size        Int
  mime_type   String  @db.VarChar(255)
  stored_path String  @db.VarChar(500)
  tickets     tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attachments_ibfk_1")

  @@index([ticket_id], map: "ticket_id")
}

model categories {
  id         Int      @id @default(autoincrement())
  name       String   @unique(map: "name") @db.VarChar(255)
  team       String   @db.VarChar(32)
  created_at DateTime @default(now()) @db.DateTime(0)
}

model email_settings {
  id                    Int      @id @default(1) @db.TinyInt
  enabled               Boolean  @default(false)
  smtp_host             String?  @db.VarChar(255)
  smtp_port             Int?
  smtp_secure           Boolean  @default(false)
  smtp_username         String?  @db.VarChar(255)
  smtp_password         String?  @db.VarChar(255)
  from_name             String?  @db.VarChar(255)
  from_email            String?  @db.VarChar(255)
  updated_at            DateTime @default(now()) @db.DateTime(0)
  updated_by            String?  @db.VarChar(255)
  notify_assigned       Boolean  @default(true)
  notify_status_changed Boolean  @default(true)
  notify_new_reply      Boolean  @default(true)
  notify_sla_breach     Boolean  @default(true)
}

model sla_settings {
  id           Int      @id @default(1) @db.TinyInt
  enabled      Boolean  @default(true)
  low_hours    Int      @default(120)
  normal_hours Int      @default(72)
  high_hours   Int      @default(24)
  updated_at   DateTime @default(now()) @db.DateTime(0)
  updated_by   String?  @db.VarChar(255)
}

model team_round_robin {
  team                   String   @id @db.VarChar(32)
  last_assigned_staff_no String?  @db.VarChar(64)
  updated_at             DateTime @default(now()) @db.DateTime(0)
}

model ticket_events {
  id         Int      @id @default(autoincrement())
  ticket_id  Int
  event_type String   @db.VarChar(32)
  from_value String?  @db.VarChar(255)
  to_value   String?  @db.VarChar(255)
  actor_name String   @db.VarChar(255)
  created_at DateTime @default(now()) @db.DateTime(0)
  tickets    tickets  @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ticket_events_ibfk_1")

  @@index([ticket_id], map: "ticket_id")
}

model ticket_notes {
  id           Int      @id @default(autoincrement())
  ticket_id    Int
  author_name  String   @db.VarChar(255)
  author_email String   @db.VarChar(255)
  message      String   @db.Text
  created_at   DateTime @default(now()) @db.DateTime(0)
  is_public    Boolean  @default(false)
  tickets      tickets  @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ticket_notes_ibfk_1")

  @@index([ticket_id], map: "ticket_id")
}

model tickets {
  id                 Int             @id @default(autoincrement())
  ticket_number      String          @unique(map: "ticket_number") @db.VarChar(64)
  category           String          @db.VarChar(255)
  team               String          @db.VarChar(255)
  priority           String          @db.VarChar(32)
  status             String          @default("Open") @db.VarChar(32)
  name               String          @db.VarChar(255)
  email              String          @db.VarChar(255)
  staff_no           String          @db.VarChar(64)
  phone              String          @db.VarChar(64)
  location           String          @db.VarChar(255)
  department         String          @db.VarChar(255)
  user_request_types String          @db.Text
  subject            String          @db.VarChar(255)
  message            String          @db.Text
  created_at         DateTime        @default(now()) @db.DateTime(0)
  assigned_to        String?         @db.VarChar(255)
  feedback           String?         @db.VarChar(10)
  feedback_at        DateTime?       @db.DateTime(0)
  attachments        attachments[]
  ticket_events      ticket_events[]
  ticket_notes       ticket_notes[]
}

model user_permissions {
  id                    Int      @id @default(autoincrement())
  staff_no              String   @unique(map: "staff_no") @db.VarChar(64)
  manage_tickets        Boolean  @default(true)
  view_reports          Boolean  @default(true)
  manage_users          Boolean  @default(true)
  manage_categories     Boolean  @default(true)
  manage_email_settings Boolean  @default(true)
  manage_sla            Boolean  @default(true)
  manage_templates      Boolean  @default(true)
  view_activity         Boolean  @default(true)
  updated_at            DateTime @default(now()) @db.DateTime(0)
  updated_by            String?  @db.VarChar(255)
  team                  String?  @db.VarChar(32)
  name                  String?  @db.VarChar(255)
  email                 String?  @db.VarChar(255)
}

model canned_responses {
  id         Int      @id @default(autoincrement())
  title      String   @db.VarChar(255)
  body       String   @db.Text
  is_public  Boolean  @default(false)
  created_at DateTime @default(now()) @db.DateTime(0)
}

model email_templates {
  id           Int      @id @default(autoincrement())
  template_key String   @unique(map: "template_key") @db.VarChar(64)
  subject      String   @db.VarChar(255)
  body_html    String   @db.Text
  updated_at   DateTime @default(now()) @db.DateTime(0)
  updated_by   String?  @db.VarChar(255)
}

model settings_audit_log {
  id          Int      @id @default(autoincrement())
  category    String   @db.VarChar(32)
  target      String?  @db.VarChar(64)
  summary     String   @db.VarChar(500)
  actor_name  String   @db.VarChar(255)
  actor_email String   @db.VarChar(255)
  created_at  DateTime @default(now()) @db.DateTime(0)

  @@index([category], map: "category")
}
