# Copy this file to .env.local (used by Next.js) and fill in real values.
# DATABASE_URL also needs to exist in a plain .env file (not .env.local) —
# the Prisma CLI (prisma generate / migrate / db pull / db seed) only reads
# .env, not .env.local. Simplest: keep the same DATABASE_URL line in both files.

GEMINI_API_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
DATABASE_URL="mysql://user:password@localhost:3306/it_service_desk"

IAMS_BASE_URL=http://localhost:3001/phniams
IAMS_LOGIN_URL=http://localhost:3001/phniams/login

APP_URL=http://localhost:3005/phn-helpdesk
